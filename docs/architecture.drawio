Cell><mxCell id="factorynote" value="CommandFactory: dictionary of name to command, case insensitive. Unknown name returns null." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="420" width="360" height="70" as="geometry" /></mxCell><mxCell id="today" value="Commands write their output through IOutputWriter. CdCommand and MkDirCommand use IFileSystemService, SetColorCommand uses IConsoleService." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="580" width="380" height="90" as="geometry" /></mxCell><mxCell id="dev" value="Differences to the teacher diagram: CommandFactory is not static (tests register fake commands), Execute takes a CommandContext, IFileSystemService and IConsoleService take the place of Workspace and IConfigurationProvider." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="1010" width="400" height="120" as="geometry" /></mxCell><mxCell id="e1" value="Use" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="program" target="shell"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="startArrow=diamondThin;startFill=0;startSize=24;endArrow=none;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;