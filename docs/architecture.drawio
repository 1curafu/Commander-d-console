t="iwriter"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="implements" style="endArrow=block;endSize=16;endFill=0;dashed=1;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0000;exitY=0.7895;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.4348;entryDx=0;entryDy=0;" edge="1" parent="1" source="cwriter" target="iwriter"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="implements" style="endArrow=block;endSize=16;endFill=0;dashed=1;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0000;exitY=0.4839;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.9783;entryDx=0;entryDy=0;" edge="1" parent="1" source="twriter" target="iwriter"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="Use" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0000;exitY=0.4464;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="1" source="shell" target="ifs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="12" y="400" /><mxPoint x="12" y="840" /></Array></mxGeometry></mxCell><mxCell id="e12" value="implements" style="endArrow=block;endSize=16;endFill=0;dashed=1;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0000;exitY=0.3659;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="1" source="fs" target="ifs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="implements" style="endArrow=block;endSize=16;endFill=0;dashed=1;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="consvc" target="iconsole"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x0" value="" style="endArrow=block;endSize=16;endFill=0;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0238;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd0" target="abstract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="1150" /><mxPoint x="1030" y="1150" /></Array></mxGeometry></mxCell><mxCell id="x1" value="" style="endArrow=block;endSize=16;endFill=0;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.1548;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd1" target="abstract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="435" y="1150" /><mxPoint x="1085" y="1150" /></Array></mxGeometry></mxCell><mxCell id="x2" value="" style="endArrow=block;endSize=16;endFill=0;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.2857;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd2" target="abstract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="1150" /><mxPoint x="1140" y="1150" /></Array></mxGeometry></mxCell><mxCell id="x3" value="Extends" style="endArrow=block;endSize=16;endFill=0;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.4167;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd3" target="abstract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="975" y="1150" /><mxPoint x="1195" y="1150" /></Array></mxGeometry></mxCell><mxCell id="x4" value="" style="endArrow=block;endSize=16;endFill=0;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5476;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd4" target="abstract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1245" y="1150" /><mxPoint x="1250" y="1150" /></Array></mxGeometry></mxCell><mxCell id="x5" value="" style="endArrow=block;endSize=16;endFill=0;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.6786;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd5" target="abstract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1515" y="1150" /><mxPoint x="1305" y="1150" /></Array></mxGeometry></mxCell><mxCell id="x6" value="" style="endArrow=block;endSize=16;endFill=0;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.8095;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmd6" target="abstract"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1785" y="1150" /><mxPoint x="1360" y="1150" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
  <diagram id="cd" name="CD command (CD-5)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner2" value="CD command (CD-5) - class view and Execute flow (current code)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cdc" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;CdCommand&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;name = &quot;cd&quot;&lt;hr size=&quot;1&quot;&gt;+ CdCommand(fileSystemService, outputWriter)&lt;br&gt;+ Execute(CommandContext): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="360" height="92" as="geometry" />
        </mxCell>
        <mxCell id="ifs2" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;IFileSystemService (used by CD)&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ CurrentDirectory: string&lt;br&gt;+ ResolvePath(string): string&lt;br&gt;+ DirectoryExists(string): bool&lt;br&gt;+ FileExists(string): bool&lt;br&gt;+ ChangeDirectory(string): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="360" height="131" as="geometry" />
        </mxCell>
        <mxCell id="res2" value="&lt;div style=&quot;text-align:center&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;IOutputWriter&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ Write(string): void&lt;br&gt;+ WriteLn(string): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="uses fileSystemService" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=open;endFill=0;" edge="1" parent="1" source="cdc" target="ifs2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="writes to" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=open;endFill=0;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cdc" target="res2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="10" y="130" />
              <mxPoint x="10" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="start" value="Execute(context)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Arguments.Count == 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="180" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="showdir" value="outputWriter.WriteLn(CurrentDirectory) and return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="195" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="resolve" value="target = fileSystemService.ResolvePath(path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="320" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="DirectoryExists(target) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="410" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="outputWriter.WriteLn(&quot;The system cannot find the path specified.&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="420" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="change" value="fileSystemService.ChangeDirectory(target)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="550" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ok" value="done (no output)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="640" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="start" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="d1" target="showdir">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="d1" target="resolve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="resolve" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="d2" target="fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="d2" target="change">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="change" target="ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cdnote" value="Notes&lt;br&gt;- The prompt (CD-9) reads CurrentDirectory after every command, so the new directory shows up by itself.&lt;br&gt;- CD.. and CD\ without a space work: the Parser cuts the command name at the first &#x27;.&#x27;, &#x27;\&#x27; or &#x27;/&#x27;, so &#x27;cd..&#x27; becomes the command cd with the argument &#x27;..&#x27;.&lt;br&gt;- CD without arguments only shows the current directory, it changes nothing." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=14;" vertex="1" parent="1">
          <mxGeometry x="1000" y="540" width="440" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>