 size=&quot;1&quot;&gt;+ CurrentDirectory: string&lt;br&gt;+ ResolvePath(string): string&lt;br&gt;+ DirectoryExists(string): bool&lt;br&gt;+ ChangeDirectory(string): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="360" height="131" as="geometry" /></mxCell><mxCell id="res2" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;CommandResult&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ Ok(string): CommandResult&lt;br&gt;+ Fail(string): CommandResult" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="360" height="80" as="geometry" /></mxCell><mxCell id="c1" value="uses FileService" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=open;endFill=0;" edge="1" parent="1" source="cdc" target="ifs2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2" value="returns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=open;endFill=0;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cdc" target="res2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="10" y="130" /><mxPoint x="10" y="520" /></Array></mxGeometry></mxCell><mxCell id="start" value="Execute(context)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="220" height="40" as="geometry" /></mxCell><mxCell id="d1" value="Arguments.Count == 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="180" width="280" height="90" as="geometry" /></mxCell><mxCell id="showdir" value="return Ok(FileService.CurrentDirectory)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="195" width="320" height="60" as="geometry" /></mxCell><mxCell id="resolve" value="target = FileService.ResolvePath(Arguments[0])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="320" width="320" height="50" as="geometry" /></mxCell><mxCell id="d2" value="FileService.DirectoryExists(target) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="410" width="280" height="90" as="geometry" /></mxCell><mxCell id="fail" value="return Fail(&quot;The system cannot find the path specified.&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="340" height="70" as="geometry" /></mxCell><mxCell id="change" value="FileService.ChangeDirectory(target)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="550" width="320" height="50" as="geometry" /></mxCell><mxCell id="ok" value="return Ok()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="640" width="220" height="40" as="geometry" /></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="d1" target="showdir"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="d1" target="resolve"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="resolve" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="d2" target="fail"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="d2" target="change"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;" edge="1" parent="1" source="change" target="ok"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cdnote" value="Notes&lt;br&gt;- The prompt (CD-9) reads CurrentDirectory after every command, so the new directory shows up by itself.&lt;br&gt;- Open point: CD.. and CD\ without a space (CD-5 criterion). The parser has to cut the command name at the first '.' or '\', so that 'cd..' becomes the command cd with the argument '..'. Decide in the team: parser (CD-14) or CD-5.&lt;br&gt;- CD without arguments only shows the current directory, it changes nothing." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=14;" vertex="1" parent="1"><mxGeometry x="1000" y="540" width="440" height="190" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>